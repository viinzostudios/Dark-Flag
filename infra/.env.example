# ── Dark Flag — Variables de entorno de infraestructura ───────────────────────
# Copiar como `.env` y reemplazar los valores antes de ejecutar docker compose.
# NUNCA commitear este archivo con valores reales.
#
# Puertos Dark Flag (diseñados para coexistir con Arena Siege Tanks en la misma máquina):
#   PostgreSQL:  host 5433  →  container 5432
#   Redis:       host 6380  →  container 6379
#   API REST:    3002
#   Game Server: 3003
#   Frontend:    4201

# PostgreSQL
POSTGRES_DB=dark_flag
POSTGRES_USER=df_user
POSTGRES_PASSWORD=cambiar_en_produccion

# JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=cambiar_por_string_aleatorio_64_chars
JWT_REFRESH_SECRET=otro_string_aleatorio_diferente_64_chars

# Stripe (obtener en dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Comunicación interna entre game-server y api
INTERNAL_SECRET=cambiar_por_string_aleatorio_32_chars
